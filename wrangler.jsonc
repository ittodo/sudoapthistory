{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nodostream-staging",
  "main": "cloudflare/src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "version_metadata":{"binding":"CF_VERSION_METADATA"},
  "triggers": {"crons":["17 * * * *"]},
  "assets": {"directory":"cloudflare/dist/public","binding":"ASSETS","run_worker_first":["/api/*","/auth/*"],"not_found_handling":"none"},
  "vars": {"SITE_ORIGIN":"https://nodostream-staging.sksk17.workers.dev","RELEASE_SHA":"unreleased","MAINTENANCE":"false","AUTH_ENABLED":"true","GOOGLE_CLIENT_ID":"221788330191-cf33apf0s7jcpqh2kc527k2mg4ng7kgh.apps.googleusercontent.com"},
  "d1_databases": [{"binding":"DB","database_name":"nodostream-staging","database_id":"636d41b6-3ed7-4f6d-8f0b-823324c4ccad","migrations_dir":"cloudflare/migrations"}],
  "env": {"production": {
    "name":"nodostream","workers_dev":false,"preview_urls":false,
    "version_metadata":{"binding":"CF_VERSION_METADATA"},
    "triggers":{"crons":["17 * * * *"]},
    "vars":{"SITE_ORIGIN":"https://nodostream.com","RELEASE_SHA":"unreleased","MAINTENANCE":"true","AUTH_ENABLED":"false","GOOGLE_CLIENT_ID":"221788330191-fs4kij4ft29g9bq93qmg3kh6sbjiclr4.apps.googleusercontent.com"},
    "d1_databases":[{"binding":"DB","database_name":"nodostream-production","database_id":"ca03a96c-acb0-4a10-8615-503df3dc5b74","migrations_dir":"cloudflare/migrations"}]
  }}
}
